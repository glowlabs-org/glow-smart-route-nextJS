## 9. Example JSX Skeleton (Step Layout)

```tsx
export default function NewCampaignPage() {
  return (
    <div className="mx-auto max-w-5xl px-4 py-10">
      <div className="md:grid md:grid-cols-12 md:gap-10">
        <StepNav className="hidden md:block md:col-span-3 sticky top-24" />
        <FormProvider {...form}>
          <form
            onSubmit={handleSubmit(onSubmit)}
            className="md:col-span-9 space-y-8"
          >
            {step === 0 && <EligibilityStep />}
            {step === 1 && <BasicsStep />}
            {step === 2 && <CriteriaTargetsStep />}
            {step === 3 && <ContributionStep />}
            {step === 4 && <DescriptionStep />}
            {step === 5 && <PreviewStep />}
            <FooterNav
              onBack={prev}
              onNext={next}
              canNext={form.formState.isValid}
            />
          </form>
        </FormProvider>
      </div>
    </div>
  );
}
```

