## 3. Accounting/State Tracking, Relational Schema (SQL‑style)

### 3.1 Epoch‑level Metadata
```sql
CREATE TABLE epoch_totals (
  epoch                INT PRIMARY KEY,
  gctl_price_usd       NUMERIC(18,6) NOT NULL,
  gctl_minted          NUMERIC(38,0) NOT NULL,
  total_gctl_staked    NUMERIC(38,0) NOT NULL,
  region_count         INT           NOT NULL,
  created_at           TIMESTAMP     DEFAULT now()
);
```

### 3.2 Control Mint

#### 3.2.1 Control Purchase 
```sql
CREATE TABLE control_purchase_events (
  tx_id        TEXT PRIMARY KEY,
  epoch        INT            NOT NULL,
  wallet       TEXT           NOT NULL,
  amount_usdc  NUMERIC(38,2)  NOT NULL,
  GCTL_minted  NUMERIC(38,0)  NOT NULL,
  ts           TIMESTAMP      DEFAULT now()
);
CREATE INDEX cp_epoch_idx ON control_purchase_events(epoch);

CREATE VIEW GCTL_balances AS
SELECT wallet,
       SUM(GCTL_minted) + COALESCE(SUM(airdrop.GCTL_airdropped), 0) AS amount
FROM   control_purchase_events cp
LEFT JOIN GCTL_airdrop_events airdrop ON cp.wallet = airdrop.wallet
GROUP  BY wallet;
```
*Note: View assumes that tokens are never transferred or burned*

#### 3.2.2 Control Airdrop Tracking

```sql
CREATE TABLE GCTL_airdrop_events (
  airdrop_id        TEXT PRIMARY KEY,
  wallet            TEXT NOT NULL,
  impact_power_points NUMERIC(38,2) NOT NULL,
  GCTL_airdropped   NUMERIC(38,0) NOT NULL,
  epoch             INT NOT NULL,
  ts                TIMESTAMP DEFAULT now()
);

-- Shadow staking tracking (default CGP staking for unstaked GCTL)
CREATE TABLE GCTL_shadow_stakes (
  shadow_stake_id   TEXT PRIMARY KEY,
  wallet            TEXT NOT NULL,
  amount            NUMERIC(38,0) NOT NULL,
  region            TEXT NOT NULL DEFAULT 'CGP',
  epoch             INT NOT NULL,
  ts                TIMESTAMP DEFAULT now()
);
```
### 3.3 Staking
```sql
CREATE TABLE GCTL_stake_events (
  tx_id     TEXT PRIMARY KEY,
  epoch     INT     NOT NULL,
  wallet    TEXT    NOT NULL,
  region    TEXT    NOT NULL,
  amount    NUMERIC(38,0) NOT NULL,
  direction CHAR(6) CHECK (direction IN ('stake','unstake')),
  ts        TIMESTAMP DEFAULT now()
);
CREATE INDEX stake_epoch_idx ON GCTL_stake_events(epoch);

CREATE VIEW GCTL_stakes AS
SELECT epoch,
       region,
       wallet,
       SUM(CASE WHEN direction='stake' THEN amount ELSE -amount END) AS amount
FROM   GCTL_stake_events
GROUP  BY epoch, region, wallet;

-- Linear unstaking schedule tracking
CREATE TABLE GCTL_unstaking_schedules (
  schedule_id       TEXT PRIMARY KEY,
  wallet            TEXT NOT NULL,
  region            TEXT NOT NULL,
  total_amount      NUMERIC(38,0) NOT NULL,
  remaining_amount  NUMERIC(38,0) NOT NULL,
  start_epoch       INT NOT NULL,
  end_epoch         INT NOT NULL,
  weekly_drip_amount NUMERIC(38,0) NOT NULL,
  status            TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','completed','cancelled')),
  ts                TIMESTAMP DEFAULT now()
);
```

### 3.4 Region Status, Activation, & Inflation
```sql
CREATE TABLE region_epoch (
  epoch           INT NOT NULL,
  region          TEXT NOT NULL,
  gctl_staked     NUMERIC(38,0) NOT NULL,
  stake_share     NUMERIC(28,12) NOT NULL,
  glw_allocated   NUMERIC(38,0) NOT NULL,
  PRIMARY KEY(epoch, region)
);

CREATE TABLE region_status (
  region           TEXT PRIMARY KEY,
  active_flag      BOOLEAN DEFAULT false,
  current_gctl_stake NUMERIC(38,0) DEFAULT 0,
  solar_farm_count INT DEFAULT 0,
  unstake_period_weeks INT DEFAULT 100  -- unstake period for the region (default 100 weeks)
);

CREATE TABLE region_activation_events (
  region   TEXT PRIMARY KEY,
  epoch    INT NOT NULL,
  stake_threshold_met BOOLEAN NOT NULL,
  solar_farm_requirement_met BOOLEAN NOT NULL,
  activated BOOLEAN GENERATED ALWAYS AS (stake_threshold_met AND solar_farm_requirement_met) STORED,
  ts       TIMESTAMP DEFAULT now()
);
```

### 3.5 Solar Farms & Ownership
```sql
CREATE TABLE solar_farms (
  farm_id                   TEXT PRIMARY KEY,
  region                    TEXT NOT NULL,
  installer_id              TEXT NOT NULL,
  owner_id                  TEXT NOT NULL,
  mw_capacity               NUMERIC(18,4) NOT NULL,
  -- Protocol Deposit can be paid in USDG, GCTL, or GLW (USDC converted to USDG)
  protocol_deposit_amount   NUMERIC(38,2) NOT NULL,
  protocol_deposit_currency TEXT NOT NULL CHECK (protocol_deposit_currency IN ('USDG','GCTL','GLW')),
  expected_credits          NUMERIC(38,4) NOT NULL,
  inflation_rewards_to_date NUMERIC(38,0) DEFAULT 0,
  built_epoch               INT           NOT NULL,
  is_purchased              BOOLEAN       DEFAULT false,
  pd_auction_status         TEXT DEFAULT 'none' CHECK (pd_auction_status IN ('none','listed','auctioned','community_node'))
);

CREATE TABLE solar_farm_purchases (
  farm_id         TEXT PRIMARY KEY REFERENCES solar_farms(farm_id),
  buyer_id        TEXT NOT NULL,
  total_usdc_paid NUMERIC(38,2) NOT NULL,
  epoch           INT NOT NULL,
  ts              TIMESTAMP DEFAULT now()
);
```

### 3.6 Protocol Deposits & Foundation Ledger
```sql
CREATE TABLE protocol_deposit_events (
  event_id         TEXT PRIMARY KEY,
  wallet           TEXT       NOT NULL,
  action_type      TEXT       NOT NULL,
  amount           NUMERIC(38,2) NOT NULL,
  currency         TEXT       NOT NULL CHECK (currency IN ('USDG','GCTL','GLW')),
  usd_equivalent   NUMERIC(38,2) NOT NULL,
  ts               TIMESTAMP  DEFAULT now()
);

CREATE TABLE foundation_wallet_ledger (
  entry_id   SERIAL PRIMARY KEY,
  source     TEXT       NOT NULL, -- e.g. 'control_sale','protocol_deposit'
  amount_usdc NUMERIC(38,2) NOT NULL,
  ts         TIMESTAMP DEFAULT now()
);

-- Asset-specific competition pools
CREATE TABLE asset_competition_pools (
  currency         TEXT NOT NULL,
  epoch            INT NOT NULL,
  total_deposits   NUMERIC(38,2) NOT NULL,
  total_rewards    NUMERIC(38,2) NOT NULL,
  PRIMARY KEY(currency, epoch)
);
```

### 3.7 PD Auction Marketplace
```sql
CREATE TABLE pd_auction_listings (
  listing_id       TEXT PRIMARY KEY,
  farm_id          TEXT NOT NULL REFERENCES solar_farms(farm_id),
  owner_id         TEXT NOT NULL,
  pd_amount        NUMERIC(38,2) NOT NULL,
  pd_currency      TEXT NOT NULL CHECK (pd_currency IN ('USDG','GCTL','GLW')),
  initial_split    NUMERIC(5,4) NOT NULL DEFAULT 0.5, -- 50% initial split
  current_split    NUMERIC(5,4) NOT NULL DEFAULT 0.5,
  weeks_since_listing INT DEFAULT 0,
  status           TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','auctioned','expired','community_node')),
  created_epoch    INT NOT NULL,
  ts               TIMESTAMP DEFAULT now()
);

CREATE TABLE pd_auction_bids (
  bid_id           TEXT PRIMARY KEY,
  listing_id       TEXT NOT NULL REFERENCES pd_auction_listings(listing_id),
  bidder_id        TEXT NOT NULL,
  bid_amount       NUMERIC(38,2) NOT NULL,
  bid_currency     TEXT NOT NULL CHECK (bid_currency IN ('USDG','GCTL','GLW')),
  status           TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','accepted','rejected','expired')),
  created_epoch    INT NOT NULL,
  ts               TIMESTAMP DEFAULT now()
);

CREATE TABLE pd_auction_splits (
  farm_id          TEXT NOT NULL REFERENCES solar_farms(farm_id),
  owner_split      NUMERIC(5,4) NOT NULL, -- percentage for farm owner
  payer_split      NUMERIC(5,4) NOT NULL, -- percentage for PD payer
  epoch            INT NOT NULL,
  PRIMARY KEY(farm_id, epoch)
);

CREATE TABLE community_nodes (
  farm_id          TEXT NOT NULL PRIMARY KEY REFERENCES solar_farms(farm_id),
  conversion_epoch INT NOT NULL,
  status           TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','inactive')),
  ts               TIMESTAMP DEFAULT now()
);
```

## 4. Admin and Monitoring

The front-end dashboard surfaces real-time protocol metrics from the database schema defined above. Key metrics include:

- **Supply & Stake Overview**
  - Total GCTL minted
  - Total GCTL airdropped to impact holders
  - Total GCTL staked and where it is staked (across all regions)
  - Total GCTL shadow staked to CGP
  - Total GCTL in unstaking schedules (we can show the projected amount to be unstaked from a region. This is known and updated per epoch)
  - Number of unique GCTL holders

- **Capital Flows**
  - Total USDC received from:
    - GCTL purchases
    - Impact credit sales (solar farm purchases)
    - Protocol deposits (by currency)

- **Region Tracking**
  - Activation status of all regions
  - Per-region GCTL stake and GLW allocation (from `region_epoch`)

- **Solar Deployment**
  - Total number of solar farms built
  - Per-region inventory of active and unpurchased farms
  - Total megawatts of solar deployed (sum of `mw_capacity`)

- **Impact Credits & Ownership**
  - Total carbon credits created across all farms
  - Number of unique impact credit owners (buyers)
  - Total number of solar farms sold (via `solar_farm_purchases`)
  - Total USDC value of impact credit sales

- **PD Auction Marketplace**
  - Number of active auction listings
  - Average auction completion time
  - Total value of PDs auctioned
  - Split distribution statistics
  - Community node conversions

- **Asset Competition Pools**
  - Per-currency deposit totals
  - Per-currency reward distributions
  - Competition pool performance metrics

- **Public Displays**
  - Impact leaderboard (credits owned per wallet)
  - Impact flaunting visualizations (e.g. user profiles)
  - Auction marketplace activity

