# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.sentry-build-plugin

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent / assistant tool directories. Local session state, never shipped — and
# .kimi-code/mcp.json holds a GitHub PAT, so an unignored one turns `git add -A`
# into a credential leak (caught 2026-08-17 by scripts/verify-before-push.sh).
.agents/
.kimi-code/
.claude/
.codex-worktrees/
